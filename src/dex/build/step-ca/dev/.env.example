# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example, dev/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=dex

# Docker image
IMAGE=dexidp/dex:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=5556
VIRTUAL_HOST=dex.local

# Step CA SSL certificate domain
LETSENCRYPT_HOST=dex.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com
# OIDC
DEX_ISSUER=https://dex.example.com/dex

DEX_O2_CLIENT_REDIRECT_URL=https://openobserve.example.com/config/redirect
DEX_O2_CLIENT_NAME=OpenObserve

# echo -n 'my-super-secret-123' | base64
DEX_O2_CLIENT_SECRET=bXktc3VwZXItc2VjcmV0LTEyMw==
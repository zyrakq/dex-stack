DEX_O2_CLIENT_NAME=OpenObserve

# echo -n 'my-super-secret-123' | base64
DEX_O2_CLIENT_SECRET=bXktc3VwZXItc2VjcmV0LTEyMw==

DEX_OIDC_ID=kanidm
DEX_OIDC_NAME=Kanidm

DEX_OIDC_CLIENT_ID=openobserve
